# Example Xbox XBE Static Recompilation Configuration (XboxXBERecomp-style)
# Generated by xbe_symbols and extended with manual analysis overrides.
# Never commit extracted XBEs or generated C++ files alongside this config.

[xbe]
# Code sections to lift (always include .text; add XDK sections like D3D, DSOUND, XPP if present)
sections = [".text", "D3D", "DSOUND", "XPP"]
# Known data-only ranges embedded inside code sections (e.g., jump tables, float constants)
data_ranges = [
    # [0x00123400, 0x00123480],
]

# Include the XDK build-specific layout/symbol definitions (e.g., 5849, 5558, 4627)
include = "sdk/xdk/5849/layout.toml"

# Manually discovered functions missed by static recursive descent
[[function]]
address = 0x00012340
name = "sub_00012340"

# Manually resolved switch/jump tables
[[switch]]
address = 0x00045678
targets = [0x00045690, 0x000456B0, 0x000456D0]

# Instruction-level hooks (call host C++ function before/after guest instruction)
[[hook]]
address = 0x00078900
before = "OnFramePresentHook"

[symbols]
# Matched XDK functions replaced by native HLE runtime implementations (0 = unmatched/stub)
D3DDevice_Swap = 0x00210040
DirectSoundCreate = 0x00245100
XInputGetState = 0x00260800
