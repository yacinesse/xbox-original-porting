# CMakeLists.port.example
#
# Production-ready CMake build template for a standalone Original Xbox static
# recompilation port linking against xboxrecomp + native Windows Direct3D 11
# graphics backend. Keep your port repo separate from the external `xboxrecomp`
# checkout.

cmake_minimum_required(VERSION 3.20)
project(xbox_game_port C)

set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)

add_compile_definitions(WIN32_LEAN_AND_MEAN NOMINMAX)

# Enable Win64 TEB-slot TLS (`gs:[0x1480 + slot * 8]`) on MinGW GCC/Clang to
# eliminate `__emutls_get_address` calls on every lifted register access.
# Pair with `examples/recomp_fast_tls.h` and verify via `scripts/verify_port_release.py`.
option(PORT_ENABLE_FAST_TLS "Use Win64 PE TLS TEB-slot registers on MinGW/Clang" ON)
if(PORT_ENABLE_FAST_TLS AND NOT MSVC)
    add_compile_definitions(RECOMP_FAST_TLS=1)
endif()

# Point to your pinned external/xboxrecomp directory
set(XBOXRECOMP_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../external/xboxrecomp"
    CACHE PATH "Path to xboxrecomp toolkit root")

# Build xboxrecomp static libraries (xbox_kernel, xbox_nv2a, xbox_apu, xbox_input, xbox_usb, ...)
add_subdirectory("${XBOXRECOMP_DIR}" "${CMAKE_BINARY_DIR}/xboxrecomp_build")

# Glob lifted C translation units (`--split 1000` recommended for fast parallel Ninja builds)
file(GLOB RECOMP_GEN_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/recomp/gen/*.c"
)

add_executable(${PROJECT_NAME} WIN32
    src/main.c
    src/recomp_manual.c
    src/nv2a_d3d11_backend.c
    ${RECOMP_GEN_SOURCES}
)

target_include_directories(${PROJECT_NAME} PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/src"
    "${CMAKE_CURRENT_SOURCE_DIR}/src/recomp/gen"
    "${XBOXRECOMP_DIR}/include"
)

if(MSVC)
    target_compile_options(${PROJECT_NAME} PRIVATE /W2 /O2 /GS- /bigobj)
    target_link_options(${PROJECT_NAME} PRIVATE /LARGEADDRESSAWARE /STACK:8388608)
else()
    # MinGW-w64 / GCC / Clang:
    # - `-O3 -fno-math-errno` accelerates lifted math, pushbuffer & VSH paths.
    # - `-static -static-libgcc` eliminates ALL non-OS runtime DLLs (including
    #   `libwinpthread-1.dll`, which STILL gets pulled in if you only pass
    #   `-Wl,-Bstatic -lwinpthread`!). Verify 0 non-OS DLLs with
    #   `scripts/verify_port_release.py`.
    target_compile_options(${PROJECT_NAME} PRIVATE -O3 -fno-math-errno -Wno-unused-variable -Wno-unused-label)
    target_link_options(${PROJECT_NAME} PRIVATE -static -static-libgcc -Wl,--stack,8388608)
endif()

target_link_libraries(${PROJECT_NAME} PRIVATE
    xboxrecomp
    d3d11
    dxgi
    dxguid
    d3dcompiler
    $<IF:$<BOOL:${MINGW}>,xinput1_4,xinput>
    winmm
    dbghelp
    ole32
    ws2_32
)
